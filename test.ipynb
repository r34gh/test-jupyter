    "import subprocess\n",
    "# scan for internal services on common ports\n",
    "script = r'''\n",
    "import socket\n",
    "hosts = [\"127.0.0.1\", \"localhost\"]\n",
    "ports = [22,80,443,3838,8000,8080,8888,9090,10250,6443,6379,5432,3306,27017,9200,5000,4317,8888]\n",
    "try:\n",
    "    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.connect((\"8.8.8.8\",80)); print(\"local IP:\", s.getsockname()[0]); s.close()\n",
    "except Exception as e: print(e)\n",
    "for h in hosts:\n",
    "    for p in ports:\n",
    "        try:\n",
    "            s = socket.create_connection((h,p), timeout=1); print(h, p, \"OPEN\"); s.close()\n",
    "        except Exception: pass\n",
    "'''\n",
    "p = subprocess.run([\"python3\", \"-c\", script], capture_output=True, text=True, timeout=60)\n",
    "print(p.stdout, p.stderr)"